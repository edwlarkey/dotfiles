#!/usr/bin/env bash
#
# Sets up my dotfiles
#

set -e

echo ''

info () {
    printf "\r\033[2K  [ \033[00;34m..\033[0m ] %s\n" "$1"
}

user () {
    printf "\r\033[2K  [ \033[00;33m##\033[0m ] %s\n" "$1"
}

success () {
    printf "\r\033[2K  [ \033[00;32mOK\033[0m ] %s\n" "$1"
}

fail () {
    printf "\r\033[2K  [\033[0;31mFAIL\033[0m] %s\n" "$1"
    echo ''
    exit
}

setup_gitconfig () {
    info 'Setup git'

    if [ -f "$HOME/.local.gitconfig" ]; then
      info "$HOME/.local.gitconfig found, deleting"
      rm "$HOME/.local.gitconfig"
    fi

    mkdir -p $HOME/.config/git
    mkdir -p $HOME/git
    ln -nfs "$HOME/dotfiles/git/gitconfig" "$HOME/.gitconfig"
    git config --file "$HOME/.config/git/config" commit.template "~/dotfiles/git/git-commit-template"
    ln -nfs "$HOME/dotfiles/git/$git_location-config" "$HOME/.config/git/config"

    success 'Git setup complete'
}

link_files () {
    info 'Linking files'
    ln -nfs "$HOME/dotfiles/vim" "$HOME/.vim"
    ln -nfs "$HOME/dotfiles/vim/vimrc" "$HOME/.vimrc"
    success 'vim linked'
    ln -nfs "$HOME/dotfiles/nvim" "$HOME/.config/nvim"
    mkdir -p "$HOME/.local/share/nvim/session"
    success 'nvim linked'
    ln -nfs "$HOME/dotfiles/bin" "$HOME/bin"
    success 'bin linked'
    ln -nfs "$HOME/dotfiles/tmux/tmux.conf" "$HOME/.tmux.conf"
    ln -nfs "$HOME/dotfiles/tmux" "$HOME/.tmux"
    success 'tmux linked'
    ln -nfs "$HOME/dotfiles/aerc" "$HOME/.config/aerc"
    success 'aerc linked'
    ln -nfs "$HOME/dotfiles/zsh" "$HOME/.zsh"
    ln -nfs "$HOME/dotfiles/zsh/zlogin" "$HOME/.zlogin"
    ln -nfs "$HOME/dotfiles/zsh/zlogout" "$HOME/.zlogout"
    ln -nfs "$HOME/dotfiles/zsh/zprofile" "$HOME/.zprofile"
    ln -nfs "$HOME/dotfiles/zsh/zshrc" "$HOME/.zshrc"
    ln -nfs "$HOME/dotfiles/zsh/zshenv" "$HOME/.zshenv"
    success 'zsh linked'
    ln -nfs "$HOME/dotfiles/xinitrc" "$HOME/.xinitrc"
    success 'xinitrc config linked'
    ln -nfs "$HOME/dotfiles/ghostty" "$HOME/.config/ghostty"
    success 'ghostty config linked'
    ln -nfs "$HOME/dotfiles/alacritty" "$HOME/.config/alacritty"
    success 'alacritty config linked'
    ln -nfs "$HOME/dotfiles/starship.toml" "$HOME/.config/starship.toml"
    success 'starship config linked'
    ln -nfs "$HOME/dotfiles/sway" "$HOME/.config/sway"
    success 'sway config linked'
    ln -nfs "$HOME/dotfiles/hypr" "$HOME/.config/hypr"
    success 'hyprland config linked'
    ln -nfs "$HOME/dotfiles/mako" "$HOME/.config/mako"
    success 'mako config linked'
    ln -nfs "$HOME/dotfiles/waybar" "$HOME/.config/waybar"
    success 'waybar config linked'
    ln -nfs "$HOME/dotfiles/wofi" "$HOME/.config/wofi"
    success 'wofi config linked'
    ln -nfs "$HOME/dotfiles/karabiner" "$HOME/.config/karabiner"
    success 'karabiner config linked'
}

make_dirs () {
    info 'Creating directories'
    mkdir -p "$HOME/.config"
    mkdir -p "$HOME/.config/git"
    mkdir -p "$HOME/.vim-backup"
    mkdir -p "$HOME/.vim-undo"
    mkdir -p "$HOME/.vim-swap"
    success 'vim dirs created'
    mkdir -p "$HOME/git"
    success "$HOME/git created"
}

pull_submodules () {
    cd "$HOME/dotfiles" && git submodule init && git submodule update
    git submodule update --init --recursive
}

install_vim_plugins () {
    info 'Install Vim plugins'
    vim +PlugInstall +qall
    success 'Plugins installed'
}

# ---------------------------------------------------------------------------
# OS 99 (classic Mac OS 9 window frames for Hyprland)
# https://github.com/caariiboouu/os-99
# ---------------------------------------------------------------------------
OS99_REPO="${OS99_REPO:-$HOME/.local/src/os-99}"
OS99_SHARE="${XDG_DATA_HOME:-$HOME/.local/share}/os99"
OS99_LIB="$HOME/.local/lib"
OS99_BIN="$HOME/.local/bin"
OS99_HYPR_SNIPPET="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/os99.lua"

setup_os99() {
    info 'Setting up OS 99 (plain Hyprland)'

    # 1. Clone (or update) the repo
    if [[ -d "$OS99_REPO/.git" ]]; then
        info "Updating $OS99_REPO"
        git -C "$OS99_REPO" pull --ff-only || true
    else
        info "Cloning os-99 → $OS99_REPO"
        mkdir -p "$(dirname "$OS99_REPO")"
        git clone --depth 1 https://github.com/caariiboouu/os-99.git "$OS99_REPO"
    fi

    # 2. Ensure directories
    mkdir -p "$OS99_SHARE/decor" "$OS99_LIB" "$OS99_BIN"

    # 3. Put the helper scripts on PATH (symlinks so updates are free)
    for f in "$OS99_REPO"/bin/os99-*; do
        [[ -x $f || -f $f ]] || continue
        ln -nfs "$f" "$OS99_BIN/$(basename "$f")"
    done
    # also expose the lib so the scripts can source it
    ln -nfs "$OS99_REPO/bin/os99-lib.sh" "$OS99_BIN/os99-lib.sh"
    success "OS 99 scripts linked into $OS99_BIN"

    # 4. Build / install the hyprbars fork (content-hashed .so)
    #    Requires: base-devel, cmake, hyprland headers (pkg-config hyprland)
    if command -v hyprctl >/dev/null 2>&1; then
        info 'Building hyprbars-os99 against current Hyprland…'
        if "$OS99_BIN/os99-hyprbars-rebuild"; then
            success 'hyprbars-os99 built and loaded'
        else
            user 'Plugin build failed – you can retry later with: os99-hyprbars-rebuild'
        fi
    else
        user 'hyprctl not found – skipping plugin build (run os99-hyprbars-rebuild after starting Hyprland)'
    fi

    # 5. Generate the window-frame art at this display’s scale
    #    Default palette = light (Platinum / Noir chrome). Use dark for Graphite.
    local palette="${OS99_PALETTE:-light}"
    info "Generating art (palette=$palette) → $OS99_SHARE/decor"
    python3 "$OS99_REPO/themes/os-99-platinum/decor/generate-art.py" \
        --out "$OS99_SHARE/decor" --palette "$palette" || {
        fail 'Art generation failed (need python3 ≥ 3.11)'
    }
    success 'Art generated'

    # 6. Tiny Hyprland config snippet (source this from your main hyprland.conf)
    cat > "$OS99_HYPR_SNIPPET" <<EOF
-- OS 99 – generated by dotfiles/setup. Safe to delete.
-- Source this from your main hyprland.lua:
--   dofile(os.getenv("HOME") .. "/.config/hypr/os99.lua")

local home = os.getenv("HOME")
local os99_share = (os.getenv("XDG_DATA_HOME") or (home .. "/.local/share")) .. "/os99"
local os99_bin   = home .. "/.local/bin"

os99_dir = os99_share .. "/decor"

if os99_dir and io.open(os99_dir .. "/bars.lua", "r") then
  dofile(os99_dir .. "/bars.lua")
end

EOF
    success "Wrote $OS99_HYPR_SNIPPET"

    # 7. Remind the user what still needs a one-line edit
    user "Optional: install a Chicago-alike font for authentic title-bar text"
    echo "    # Arch/AUR:  yay -S ttf-chicagoflf"
    echo "    # elsewhere: drop ChicagoFLF.ttf into ~/.local/share/fonts && fc-cache -f"
    echo
    success 'OS 99 setup complete – restart Hyprland or run: os99-window-bars'
}

remove_os99() {
    info 'Removing OS 99'

    # Unload the plugin if Hyprland is running
    if command -v hyprctl >/dev/null 2>&1; then
        # best-effort unload of every os99 / hyprbars build
        for so in "$OS99_LIB"/libhyprbars-os99*.so; do
            [[ -f $so ]] && hyprctl plugin unload "$so" 2>/dev/null || true
        done
        # also try the pointer file
        if [[ -r $OS99_LIB/libhyprbars-os99.path ]]; then
            hyprctl plugin unload "$(cat "$OS99_LIB/libhyprbars-os99.path")" 2>/dev/null || true
        fi
    fi

    # Remove art, state, plugin binaries, and the config snippet
    rm -rf "$OS99_SHARE"
    rm -f  "$OS99_LIB"/libhyprbars-os99*.so \
           "$OS99_LIB"/libhyprbars-os99.path \
           "$OS99_LIB"/libhyprbars-os99.built
    rm -f  "$OS99_HYPR_SNIPPET"

    # Remove the PATH symlinks (leave the clone itself – user can rm -rf $OS99_REPO)
    for f in "$OS99_BIN"/os99-*; do
        [[ -L $f ]] && rm -f "$f"
    done

    # Leave a note about the one-line source that may still be in hyprland.conf
    user "If you added a 'source = …/os99.lua' line to hyprland.conf, delete it."
    success 'OS 99 removed (repo left at '"$OS99_REPO"'; delete manually if desired)'
}

# setup_gitconfig
PS3='Set up for which location: '
options=("Home" "Work" "Other" "Quit")
select opt in "${options[@]}"
do
    case $opt in
        "Home")
            info "Setting up for Home"
            git_location=home
            break
            ;;
        "Work")
            info "Setting up for Work"
            git_location=work
            break
            ;;
        "Quit")
            exit 1
            ;;
        *) echo invalid option;;
    esac
done

make_dirs
setup_gitconfig
link_files
pull_submodules
# install_vim_plugins

# Optional OS 99
user "Install OS 99 window frames? (y/N)"
read -r ans
if [[ $ans =~ ^[Yy] ]]; then
    setup_os99
fi
