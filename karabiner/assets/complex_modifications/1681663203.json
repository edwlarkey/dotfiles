{
  "title": "Caps Lock to Escape, enable Control when held",
  "rules": [
    {
      "description": "Caps Lock to Escape on single press, Control on press and hold.",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ],
          "to_if_held_down": [
            {
              "key_code": "left_control"
            }
          ]
        }
      ]
    }
  ]
}
